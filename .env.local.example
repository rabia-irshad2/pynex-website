# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Resend (https://resend.com) — used for the contact form and newsletter emails
RESEND_API_KEY=your_resend_api_key
RESEND_AUDIENCE_ID=your_resend_audience_id
CONTACT_TO_EMAIL=pynexcompany@gmail.com
CONTACT_FROM_EMAIL=onboarding@resend.dev

# Google Analytics 4 measurement ID (starts with G-)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# WhatsApp number in international format, no + or spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=923141754779
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
